# Reviewed plaintext call sites in pkg/ (go-auth#48; gate: test/ci/credential_residue_test.go).
#
# One line per call: "path:function ID". A function with several calls has
# several lines. ID is a row of docs/security/credential-residues.md, or
# "internal" when the plaintext never leaves locked memory or the process's own
# primitive (a fill, a constant-time compare, an HMAC/SHA key schedule, a
# length check).
#
# Adding a line is a security review: name the residue, update the register
# if it is a new one, and say in the PR why the dependency forces it.

# The helper every string-only dependency goes through. Its callers are listed
# below under their own residue IDs.
pkg/internal/credential/credential.go:WithTransientString internal

# R1: go-ldap Bind(username, password string), service bind and user bind.
pkg/ldap/authenticator.go:Authenticator.Authenticate R1
pkg/ldap/authenticator.go:Authenticator.Authenticate R1

# R2: layeh.com/radius keeps the shared secret on the packet and hashes it;
# the password is obfuscated straight out of its borrow (UserPassword_Set).
pkg/radius/authenticator.go:Authenticator.Authenticate R2
pkg/radius/authenticator.go:Authenticator.Authenticate internal
pkg/radius/eaptls.go:Authenticator.authenticateEAPTLS R2

# R3: tacplus ConnConfig.Secret and ClientSession.Continue(string).
pkg/tacacs/authenticator.go:Authenticator.Authenticate R3
pkg/tacacs/authenticator.go:Authenticator.handleReply R3

# R5: net/http, crypto/tls and golang-jwt take strings.
pkg/oauth/credential.go:withFormBody R5
pkg/oauth/credential.go:withFormBody internal
pkg/oauth/credential.go:withFormBody internal
pkg/oauth/oidc_userinfo.go:userInfoClient.fetchUserInfo R5
pkg/oauth/oidc_validator.go:oidcValidator.ValidateIDToken R5
pkg/oauth/validator.go:tokenValidator.sendIntrospection R5
pkg/oauth/validator.go:tokenValidator.validateJWT R5
pkg/yubikey/yubicloud_validator.go:HTTPValidator.Validate R5

# R6: cgo bindings that take a Go string and C.CString it.
pkg/pam/pam_default_cgo.go:pamSession.Authenticate R6
pkg/pkcs11/system_provider_pkcs11.go:nativeSession.Login R6

# R8: OTP material that has to be handed out as text.
pkg/otp/authenticator.go:Authenticator.derive R8
pkg/otp/seed.go:EncodeSecret R8
pkg/otp/seed.go:EncodeSecret internal

# internal: plaintext stays in locked memory or the process's own primitive.
pkg/oauth/authenticator.go:Authenticator.ValidateToken internal
pkg/oauth/credential.go:openJSON internal
pkg/oauth/credential.go:sealJSONString internal
pkg/oauth/credential.go:tokenFingerprint internal
pkg/oauth/flows.go:flowHandler.exchangeAuthorizationCodePKCE internal
pkg/oauth/oidc_validator.go:oidcValidator.validateAtHash internal
pkg/oauth/pkce.go:NewVerifier internal
pkg/oauth/pkce.go:Verifier.open internal
pkg/oauth/pkce.go:newPKCEVerifier internal
pkg/oauth/pkce.go:newPKCEVerifier internal
pkg/oauth/pkce.go:pkceChallenge internal
pkg/otp/authenticator.go:Authenticator.authenticateHOTP internal
pkg/otp/authenticator.go:Authenticator.authenticateTOTP internal
pkg/otp/authenticator.go:Authenticator.authenticateTOTP internal
pkg/otp/seed.go:DecodeSeed internal
pkg/otp/seed.go:DecodeSeed internal
pkg/otp/seed.go:GenerateProtectedSecret internal
pkg/yubikey/yubicloud_validator.go:computeSignature internal
pkg/yubikey/yubicloud_validator.go:withDecodedAPIKey internal
